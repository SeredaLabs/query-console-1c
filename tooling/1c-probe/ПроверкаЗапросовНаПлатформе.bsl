// Модуль формы внешней обработки «ПроверкаЗапросовНаПлатформе» (Проверка запросов на платформе).
//
// Проверяет тексты запросов на той платформе, где открыта обработка, и выдаёт
// результат по каждому запросу одной строкой JSON (формат JSON Lines):
//   name           — имя пробы (из строки-разделителя «//# <имя>»);
//   platformBuild  — версия платформы (СистемнаяИнформация.ВерсияПриложения);
//   platformDate   — дата проверки;
//   query          — исходный текст;
//   designerOk     — текст принят схемой запроса (как «Конструктор запроса»);
//   designerError  — ошибка схемы запроса, если не принят;
//   query_text     — канонический текст схемы запроса (ПолучитьТекстЗапроса);
//   compileOk      — запрос компилируется (Запрос.НайтиПараметры, без выполнения);
//   compileError   — ошибка компиляции, если есть;
//   valid          — приняты оба шага.
// Запросы не выполняются, данные базы не читаются и не изменяются.
//
// Реквизиты формы (все типа «Строка» неограниченной длины):
//   ТекстЗапросов  — запросы текстом (многострочное поле);
//   ФайлЗапросов   — путь к файлу с запросами (UTF-8, ANSI или UTF-16); если задан, читается вместо поля;
//   ФайлРезультата — путь для записи результата (UTF-8); если пуст, файл не пишется;
//   Результат      — результат (многострочное поле, только просмотр).
// Команда формы: «Проверить» (действие — процедура Проверить).
// У полей ФайлЗапросов и ФайлРезультата включена «Кнопка выбора», событие
// «НачалоВыбора» — процедуры ФайлЗапросовНачалоВыбора и ФайлРезультатаНачалоВыбора.
//
// Формат входа: несколько запросов разделяются строкой, начинающейся с «//#»,
// за которой идёт имя пробы. Текст без разделителей — один запрос с именем «query».
//   //# PQ-expression.math-functions.acos
//   ВЫБРАТЬ ACOS(0.5) КАК Ф1 ИЗ РегистрСведений.КурсыВалют КАК К
//   //# PQ-group.grouping-sets.1
//   ВЫБРАТЬ …

&НаКлиенте
Процедура Проверить(Команда)

	Текст = ТекстЗапросов;
	Если ЗначениеЗаполнено(ФайлЗапросов) Тогда
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(ФайлЗапросов, КодировкаТекста.UTF8);
		Текст = Документ.ПолучитьТекст();
		// Символ замены U+FFFD — файл не в UTF-8 (например, пересохранён в
		// Блокноте как ANSI): тогда читается как Windows-1251.
		Если СтрНайти(Текст, Символ(65533)) > 0 Тогда
			Документ.Прочитать(ФайлЗапросов, КодировкаТекста.ANSI);
			Текст = Документ.ПолучитьТекст();
		КонецЕсли;
		// Нулевые символы — файл в UTF-16 (например, «Юникод» в Блокноте).
		Если СтрНайти(Текст, Символ(0)) > 0 Тогда
			Документ.Прочитать(ФайлЗапросов, КодировкаТекста.UTF16);
			Текст = Документ.ПолучитьТекст();
		КонецЕсли;
		// Нулевые символы остались — файл повреждён (например, не докачан);
		// такой текст нельзя передать на сервер.
		Если СтрНайти(Текст, Символ(0)) > 0 Тогда
			ПоказатьПредупреждение(, "Файл запросов содержит нулевые символы: он повреждён или не текстовый. Сохраните запросы в UTF-8 и повторите.");
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		ПоказатьПредупреждение(, "Нет запросов: заполните поле «Текст запросов» или укажите файл.");
		Возврат;
	КонецЕсли;

	// Схема запроса доступна только на сервере.
	Результат = ПроверитьНаСервере(Текст);

	Если ЗначениеЗаполнено(ФайлРезультата) Тогда
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(Результат);
		Документ.Записать(ФайлРезультата, КодировкаТекста.UTF8);
	КонецЕсли;

	ПоказатьПредупреждение(, СтрШаблон("Проверено запросов: %1.", СтрЧислоСтрок(Результат)));

КонецПроцедуры

&НаКлиенте
Процедура ФайлЗапросовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Файл с запросами";
	Диалог.Фильтр = "Запросы (*.txt)|*.txt|Все файлы (*.*)|*.*";
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.ПолноеИмяФайла = ФайлЗапросов;
	Диалог.Показать(Новый ОписаниеОповещения("ФайлЗапросовВыборЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ФайлЗапросовВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	// Неопределено — диалог закрыт без выбора.
	Если ВыбранныеФайлы <> Неопределено Тогда
		ФайлЗапросов = ВыбранныеФайлы[0];
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФайлРезультатаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Файл результата";
	Диалог.Фильтр = "JSON Lines (*.jsonl)|*.jsonl|Все файлы (*.*)|*.*";
	Диалог.ПолноеИмяФайла = ФайлРезультата;
	Диалог.Показать(Новый ОписаниеОповещения("ФайлРезультатаВыборЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ФайлРезультатаВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено Тогда
		ФайлРезультата = ВыбранныеФайлы[0];
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНаСервере(Текст)

	Инфо = Новый СистемнаяИнформация;
	Версия = Инфо.ВерсияПриложения;
	Дата = Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd");

	Строки = Новый Массив;
	Для Каждого Проба Из РазобратьПробы(Текст) Цикл
		Строки.Добавить(ПроверитьЗапрос(Проба.Имя, Проба.Текст, Версия, Дата));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция РазобратьПробы(Текст)

	Пробы = Новый Массив;
	Имя = "query";
	СтрокиПробы = Новый Массив;

	Для Номер = 1 По СтрЧислоСтрок(Текст) Цикл
		ТекущаяСтрока = СтрПолучитьСтроку(Текст, Номер);
		Если СтрНачинаетсяС(ТекущаяСтрока, "//#") Тогда
			ДобавитьПробу(Пробы, Имя, СтрокиПробы);
			Имя = СокрЛП(Сред(ТекущаяСтрока, 4));
			СтрокиПробы = Новый Массив;
		Иначе
			СтрокиПробы.Добавить(ТекущаяСтрока);
		КонецЕсли;
	КонецЦикла;
	ДобавитьПробу(Пробы, Имя, СтрокиПробы);

	Возврат Пробы;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьПробу(Пробы, Имя, СтрокиПробы)

	// Блок только из пустых строк и комментариев (например, шапка файла) — не запрос.
	ЕстьКод = Ложь;
	Для Каждого СтрокаПробы Из СтрокиПробы Цикл
		Код = СокрЛП(СтрокаПробы);
		Если Не ПустаяСтрока(Код) И Не СтрНачинаетсяС(Код, "//") Тогда
			ЕстьКод = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьКод Тогда
		ТекстПробы = СокрЛП(СтрСоединить(СтрокиПробы, Символы.ПС));
		Пробы.Добавить(Новый Структура("Имя, Текст", Имя, ТекстПробы));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьЗапрос(Имя, Текст, Версия, Дата)

	Ответ = Новый Структура;
	Ответ.Вставить("name", Имя);
	Ответ.Вставить("platformBuild", Версия);
	Ответ.Вставить("platformDate", Дата);
	Ответ.Вставить("query", Текст);

	// 1. Как «Конструктор запроса»: схема запроса и её канонический текст.
	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(Текст);
		Ответ.Вставить("designerOk", Истина);
		Ответ.Вставить("query_text", Схема.ПолучитьТекстЗапроса());
	Исключение
		Ответ.Вставить("designerOk", Ложь);
		Ответ.Вставить("designerError", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 2. Как исполнение: компиляция запроса без выполнения.
	Попытка
		Запрос = Новый Запрос(Текст);
		Запрос.НайтиПараметры();
		Ответ.Вставить("compileOk", Истина);
	Исключение
		Ответ.Вставить("compileOk", Ложь);
		Ответ.Вставить("compileError", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Ответ.Вставить("valid", Ответ.designerOk И Ответ.compileOk);

	Возврат ВСтрокуJSON(Ответ);

КонецФункции

&НаСервереБезКонтекста
Функция ВСтрокуJSON(Значение)

	Запись = Новый ЗаписьJSON;
	// Одна строка на запрос: без переносов внутри JSON.
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции
